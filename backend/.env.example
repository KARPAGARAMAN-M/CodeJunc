# ========================================================
# CodeJunc Backend Environment Configuration
# ========================================================

# Server Port (Render/Railway sets PORT; SERVER_PORT used as fallback; default: 8080)
PORT=8080
SERVER_PORT=8080

# CORS Allowed Origins (comma-separated origins for production frontend, e.g. Vercel)
# Localhost development origins (http://localhost:3000, http://127.0.0.1:3000) are always preserved automatically.
CORS_ALLOWED_ORIGINS=https://codejunc.vercel.app,http://localhost:3000

# Judge0 Base URL
# Default public Community Edition (no API key required):
JUDGE0_BASE_URL=https://ce.judge0.com

# If using RapidAPI Judge0 CE:
# JUDGE0_BASE_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_API_KEY=your_rapidapi_key_here
# JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# Optional custom API key and host (leave empty if not needed)
JUDGE0_API_KEY=
JUDGE0_API_HOST=
