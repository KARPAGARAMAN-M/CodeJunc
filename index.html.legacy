<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" id="theme-color" content="#0D1117" />
    <title>CodeJunc — Code Without Distractions</title>
    <meta
      name="description"
      content="A premium, minimal, distraction-free online coding workspace with dark and light themes."
    />

    <!-- CodeJunc Brand Favicons & Icons -->
    <link rel="icon" type="image/png" sizes="32x32" href="assets/brand/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="assets/brand/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="assets/brand/apple-touch-icon.png" />
    <link rel="manifest" href="manifest.json" />

    <!-- Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Initial Theme & Route Detection (instant, zero flicker) -->
    <script>
      (function () {
        try {
          // 1. Theme Detection: System preference as default on first visit
          var saved = localStorage.getItem('cj.theme');
          var systemDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          var theme;
          if (saved === 'light' || saved === 'dark' || saved === 'united' || saved === 'crimson-forge') {
            theme = saved;
          } else if (saved === 'system') {
            theme = systemDark ? 'dark' : 'light';
          } else {
            // First time visitor: automatically detect system OS preference
            theme = systemDark ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', theme);
          var meta = document.getElementById('theme-color');
          if (meta) {
            meta.setAttribute('content', theme === 'united' ? '#1A1A1A' : (theme === 'crimson-forge' ? '#0B0F14' : (theme === 'dark' ? '#0D1117' : '#FFFFFF')));
          }

          // 2. Route Detection: Direct access or refresh while inside workspace
          var hash = window.location.hash || '';
          var search = window.location.search || '';
          var isWorkspaceRoute = hash.indexOf('workspace') !== -1 || search.indexOf('workspace') !== -1 || sessionStorage.getItem('cj.route') === 'workspace';
          if (isWorkspaceRoute) {
            document.documentElement.classList.add('route-workspace');
          }
        } catch (e) {}
      })();
    </script>

    <!-- Monaco Editor Loader -->
    <script src="https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs/loader.js"></script>
    <link rel="stylesheet" href="css/styles.css" />
  </head>
  <body class="is-welcome">
    <!-- ============================================================
         WELCOME PAGE — Professional Developer Experience
         ============================================================ -->
    <div class="welcome" id="welcome" aria-hidden="false">
      <!-- Background Technical Grid & Ambient Lighting -->
      <div class="welcome-grid-bg" aria-hidden="true"></div>
      <div class="welcome-ambient-glow" aria-hidden="true"></div>

      <!-- Welcome Top Utility Bar -->
      <header class="welcome-topbar">
        <div class="welcome-topbar-left">
          <span class="welcome-badge-pill">
            <span class="badge-live-pulse" aria-hidden="true"></span>
            <span class="badge-text">CodeJunc v2.4</span>
            <span class="badge-divider" aria-hidden="true">/</span>
            <span class="badge-sub">Online Compiler</span>
          </span>
        </div>
        <div class="welcome-topbar-right">
          <button
            class="welcome-theme-toggle"
            id="welcome-theme-btn"
            type="button"
            aria-label="Toggle theme"
            title="Toggle Light / Dark mode"
          >
            <span class="theme-toggle-icon" id="welcome-theme-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="4"/>
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
              </svg>
            </span>
            <span class="theme-toggle-text" id="welcome-theme-text">Theme</span>
          </button>
        </div>
      </header>

      <!-- Main Welcome Content -->
      <div class="welcome-scroll-wrap">
        <div class="welcome-inner">
          <!-- Refined Brand Mark Showcase -->
          <div class="welcome-brand-showcase">
            <div class="welcome-mark-frame">
              <img
                class="welcome-mark"
                src="assets/brand/brand-mark-transparent.png"
                alt="CodeJunc Brand Mark"
                width="116"
                height="84"
              />
            </div>
          </div>

          <!-- Headline & Tagline -->
          <div class="welcome-headings">
            <h1 class="welcome-title">CodeJunc</h1>
            <p class="welcome-tagline">Code Without Distractions.</p>
            <p class="welcome-desc">
              High-performance, zero-setup online coding platform with instant compilation, intelligent syntax themes, and keyboard-first workflow.
            </p>
          </div>

          <!-- Start Coding CTA + Keyboard Hint -->
          <div class="welcome-actions">
            <button class="btn-welcome" id="btn-start" type="button" title="Start coding (or press Enter)">
              <span class="btn-welcome-text">Start Coding</span>
              <span class="arrow-glyph" aria-hidden="true">→</span>
              <kbd class="welcome-kbd" aria-hidden="true">↵ Enter</kbd>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- ============================================================
         CODING WORKSPACE
         Layout:
         CodeJunc Logo   Theme ▼   Language ▼     Run ▶
         ───────────────────────────────────────────────────
         CODE EDITOR
         ───────────────────────────────────────────────────
         Output
         ============================================================ -->
    <div class="workspace" id="workspace" aria-hidden="true">
      <a class="skip-link" href="#editor">Skip to editor</a>

      <!-- Header -->
      <header class="topbar">
        <div class="topbar-inner">
          <!-- Primary CodeJunc Logo (Dark & Light versions) -->
          <a class="brand" href="./" id="brand-link" aria-label="CodeJunc home" title="CodeJunc">
            <img
              class="brand-logo-img brand-logo-dark"
              src="assets/brand/logo-dark-transparent.png"
              alt="CodeJunc"
              height="28"
            />
            <img
              class="brand-logo-img brand-logo-light"
              src="assets/brand/logo-light-transparent.png"
              alt="CodeJunc"
              height="28"
            />
          </a>

          <!-- Topbar Actions: Theme ▼  Language ▼  Run ▶ -->
          <div class="topbar-actions">
            <!-- Theme Selector Dropdown -->
            <div class="picker theme-picker" id="theme-picker">
              <button
                class="picker-btn"
                id="theme-btn"
                type="button"
                aria-haspopup="listbox"
                aria-expanded="false"
                aria-label="Select theme"
              >
                <span class="picker-ico" id="theme-btn-ico" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="4"/>
                    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
                  </svg>
                </span>
                <span class="picker-label" id="theme-btn-label">Dark</span>
                <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m6 9.5 6 6 6-6" />
                </svg>
              </button>
              <div class="picker-menu theme-menu" id="theme-menu" role="listbox" aria-label="Theme selection" inert>
                <button type="button" class="picker-opt" role="option" data-theme-val="united" aria-selected="false" tabindex="-1">
                  <svg class="opt-ico" viewBox="0 0 24 24" fill="none" stroke="#DA291C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  </svg>
                  <span class="opt-name">🔴 United</span>
                  <svg class="check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m4.5 12.5 5 5 10-11" />
                  </svg>
                </button>
                <button type="button" class="picker-opt" role="option" data-theme-val="crimson-forge" aria-selected="false" tabindex="-1">
                  <svg class="opt-ico" viewBox="0 0 24 24" fill="none" stroke="#DA3633" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>
                  </svg>
                  <span class="opt-name">🔥 Crimson Forge</span>
                  <svg class="check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m4.5 12.5 5 5 10-11" />
                  </svg>
                </button>
                <button type="button" class="picker-opt" role="option" data-theme-val="dark" aria-selected="true" tabindex="-1">
                  <svg class="opt-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
                  </svg>
                  <span class="opt-name">Dark</span>
                  <svg class="check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m4.5 12.5 5 5 10-11" />
                  </svg>
                </button>
                <button type="button" class="picker-opt" role="option" data-theme-val="light" aria-selected="false" tabindex="-1">
                  <svg class="opt-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="4"/>
                    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
                  </svg>
                  <span class="opt-name">Light</span>
                  <svg class="check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m4.5 12.5 5 5 10-11" />
                  </svg>
                </button>
                <button type="button" class="picker-opt" role="option" data-theme-val="system" aria-selected="false" tabindex="-1">
                  <svg class="opt-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect width="20" height="14" x="2" y="3" rx="2"/>
                    <line x1="8" x2="16" y1="21" y2="21"/>
                    <line x1="12" x2="12" y1="17" y2="21"/>
                  </svg>
                  <span class="opt-name">System Default</span>
                  <svg class="check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m4.5 12.5 5 5 10-11" />
                  </svg>
                </button>
              </div>
            </div>

            <!-- Language Selector Dropdown -->
            <div class="picker lang-picker" id="lang-picker">
              <button
                class="picker-btn"
                id="lang-btn"
                type="button"
                aria-haspopup="listbox"
                aria-expanded="false"
                aria-label="Select language"
              >
                <span class="picker-ico" id="lang-btn-icon" aria-hidden="true"></span>
                <span class="picker-label" id="lang-btn-label">Python</span>
                <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m6 9.5 6 6 6-6" />
                </svg>
              </button>
              <div class="picker-menu lang-menu" id="lang-menu" role="listbox" aria-label="Language selection" inert></div>
            </div>

            <!-- Run Button (Prominent GitHub Style) -->
            <button class="btn-run" id="btn-run" type="button" title="Run code (Ctrl + Enter)">
              <span class="run-icon-wrap" aria-hidden="true">
                <svg class="ico-play" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M8 5.2v13.6c0 .8.9 1.3 1.6.9l10.2-6.8a1 1 0 0 0 0-1.8L9.6 4.3A1 1 0 0 0 8 5.2Z" />
                </svg>
                <span class="run-spinner" aria-hidden="true"></span>
              </span>
              <span class="run-label">Run</span>
              <kbd class="run-kbd" aria-hidden="true">Ctrl ↵</kbd>
            </button>
          </div>
        </div>
      </header>

      <!-- Main Workspace -->
      <main class="app">
        <!-- Monaco Code Editor Card -->
        <section class="editor-card" id="editor-card" aria-label="Code editor">
          <div class="editor-head">
            <div class="editor-file">
              <span class="file-dot" id="dirty-dot" hidden aria-label="Unsaved changes"></span>
              <span class="file-name" id="file-name">main.py</span>
              <span class="file-lang" id="file-lang">Python</span>
            </div>
            <div class="editor-actions">
              <button class="icon-btn" id="btn-reset" type="button" title="Reset starter code" aria-label="Reset starter code">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3.8 8.6A8.5 8.5 0 1 1 3.2 13" />
                  <path d="M3.8 3.6v5h5" />
                </svg>
              </button>
              <button class="icon-btn" id="btn-download" type="button" title="Download file" aria-label="Download file">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 3.5v11" />
                  <path d="M7.5 10.5 12 15l4.5-4.5" />
                  <path d="M4.5 16.5v3c0 1 .8 1.8 1.8 1.8h11.4c1 0 1.8-.8 1.8-1.8v-3" />
                </svg>
              </button>
              <button class="icon-btn" id="btn-clear-code" type="button" title="Clear editor" aria-label="Clear editor">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 6.5h16" />
                  <path d="M9.5 6.5V4.4c0-.8.6-1.4 1.4-1.4h2.2c.8 0 1.4.6 1.4 1.4v2.1" />
                  <path d="m6.5 6.5.8 12.2c.1.9.8 1.6 1.7 1.6h6c.9 0 1.6-.7 1.7-1.6l.8-12.2" />
                  <path d="M10 10.5v6M14 10.5v6" />
                </svg>
              </button>
            </div>
          </div>

          <!-- Monaco Host -->
          <div class="editor-host" id="editor">
            <!-- Empty Editor Brand Watermark -->
            <div class="editor-watermark" id="editor-watermark" aria-hidden="true">
              <img class="wm-img" src="assets/brand/brand-mark-transparent.png" alt="" />
            </div>
          </div>

          <!-- Editor Status Foot -->
          <div class="editor-foot">
            <div class="editor-foot-left">
              <span id="editor-note"><i class="lang-dot"></i>Python · interpreted</span>
            </div>
            <div class="editor-foot-right">
              <span id="indent-info">Spaces: 4</span>
              <span id="encoding-info">UTF-8</span>
              <span id="caret-info">Ln 1, Col 1</span>
            </div>
          </div>
        </section>

        <!-- Drag Resizer Handle -->
        <div class="resizer" id="resizer" role="separator" aria-orientation="horizontal" aria-label="Resize panels" tabindex="0">
          <div class="resizer-line"></div>
          <div class="resizer-thumb"></div>
        </div>

        <!-- Output Panel Below Editor -->
        <section class="output-card" id="output-card" aria-label="Program output">
          <div class="output-head">
            <div class="output-tabs" role="tablist" aria-label="Output and input">
              <button class="tab" id="tab-output" type="button" role="tab" aria-selected="true" aria-controls="panel-output">
                Output
              </button>
              <button class="tab" id="tab-input" type="button" role="tab" aria-selected="false" aria-controls="panel-input" tabindex="-1">
                Input
              </button>
            </div>
            <div class="output-tools">
              <span class="status-chip is-idle" id="status-chip" role="status" aria-live="polite">Ready</span>
              <button class="icon-btn output-only" id="btn-copy" type="button" title="Copy output" aria-label="Copy output" disabled>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="8.5" y="8.5" width="12" height="12" rx="2.5" />
                  <path d="M15.5 5.5v-1c0-1-.8-1.8-1.8-1.8H6c-1 0-1.8.8-1.8 1.8v7.7c0 1 .8 1.8 1.8 1.8h1" />
                </svg>
              </button>
              <button class="icon-btn output-only" id="btn-clear-output" type="button" title="Clear output" aria-label="Clear output">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 6.5h16" />
                  <path d="M9.5 6.5V4.4c0-.8.6-1.4 1.4-1.4h2.2c.8 0 1.4.6 1.4 1.4v2.1" />
                  <path d="m6.5 6.5.8 12.2c.1.9.8 1.6 1.7 1.6h6c.9 0 1.6-.7 1.7-1.6l.8-12.2" />
                </svg>
              </button>
            </div>
          </div>

          <div class="output-body" id="output-body">
            <!-- Output Console -->
            <div id="panel-output" role="tabpanel" aria-labelledby="tab-output">
              <!-- Empty Output Prompt with CJ Brand Mark detail -->
              <div class="output-empty" id="output-empty">
                <div class="empty-brand-wrap" aria-hidden="true">
                  <img class="empty-mark" src="assets/brand/brand-mark-transparent.png" alt="" />
                </div>
                <p id="empty-title">Ready to run</p>
                <small id="empty-hint">Press <kbd>Ctrl</kbd> + <kbd>↵</kbd> or click <strong>Run ▶</strong></small>
              </div>

              <div class="output-running" id="output-running" hidden>
                <span class="spinner" aria-hidden="true"></span>
                <span id="running-label">Running</span>
              </div>

              <pre class="output-text" id="output-text" hidden></pre>
              <div class="output-errors" id="output-errors" hidden></div>
              <div class="output-notes" id="output-notes" hidden></div>
            </div>

            <!-- Stdin Input -->
            <div id="panel-input" role="tabpanel" aria-labelledby="tab-input" hidden>
              <textarea
                id="stdin"
                spellcheck="false"
                autocomplete="off"
                autocapitalize="off"
                placeholder="Program input (stdin)&#10;One value per line, or space-separated.&#10;&#10;e.g.&#10;5&#10;12"
                aria-label="Program input (stdin)"
              ></textarea>
            </div>
          </div>

          <div class="output-foot">
            <span id="output-meta">Ready</span>
            <span class="foot-hint" id="foot-hint">Execution Environment</span>
          </div>
        </section>
      </main>

      <!-- Toast Feedback -->
      <div class="toast" id="toast" role="status" aria-live="polite">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m4.5 12.5 5 5 10-11" />
        </svg>
        <span id="toast-text"></span>
      </div>
    </div>

    <!-- Application Scripts -->
    <script src="js/data.js"></script>
    <script src="js/editor.js"></script>
    <script src="js/runner.js"></script>
    <script src="js/app.js"></script>
  </body>
</html>
